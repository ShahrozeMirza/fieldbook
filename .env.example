# Database connection string.
# Development: leave empty to use the local SQLite file ./dev.db.
# Production: the Turso database URL, e.g. libsql://fieldbook-<org>.turso.io
DATABASE_URL=

# Turso auth token (`turso db tokens create <db>`). Only needed with a libsql:// URL.
TURSO_AUTH_TOKEN=

# Password for the "admin" user, applied when the seed runs.
# Leave empty to use the demo password.
ADMIN_PASSWORD=

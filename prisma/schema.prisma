generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  /// One of: lead, prospect, customer, inactive (validated in src/lib/contacts.ts)
  status    String   @default("lead")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deals     Deal[]

  @@index([status])
}

model Deal {
  id        String   @id @default(cuid())
  title     String
  /// Whole US dollars
  value     Int
  /// One of: lead, contacted, proposal, won, lost (validated in src/lib/deals.ts)
  stage     String   @default("lead")
  /// Order within the stage column, ascending
  position  Int      @default(0)
  /// When the deal entered Won or Lost; null while open
  closedAt  DateTime?
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage, position])
  @@index([stage, closedAt])
  @@index([contactId])
}

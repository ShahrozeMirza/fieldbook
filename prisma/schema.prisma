generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  company   String?
  /// One of: lead, prospect, customer, inactive (validated in src/lib/contacts.ts)
  status    String   @default("lead")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
